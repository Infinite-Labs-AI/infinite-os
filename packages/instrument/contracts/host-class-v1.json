{
  "version": 1,
  "rule": "production host class: deny list (host-deny-v1, plus a bare suffix) minus the Vercel production-alias shape (one label, no -git-, no 9-char [a-z0-9] segment with a digit after the first)",
  "classes": {
    "production_alias": "a *.vercel.app host accepted as a production host",
    "preview": "never a production host (preview-shaped, local, or a bare platform domain)",
    "other": "not deny-listed: a custom domain"
  },
  "cases": [
    {
      "host": "acme.vercel.app",
      "class": "production_alias"
    },
    {
      "host": "infinite-tag-smoke-site.vercel.app",
      "class": "production_alias"
    },
    {
      "host": "acme-store-acme.vercel.app",
      "class": "production_alias"
    },
    {
      "host": "acme-chaos-edge.vercel.app",
      "class": "production_alias"
    },
    {
      "host": "my-marketing-site.vercel.app",
      "class": "production_alias"
    },
    {
      "host": "Acme.Vercel.App.",
      "class": "production_alias"
    },
    {
