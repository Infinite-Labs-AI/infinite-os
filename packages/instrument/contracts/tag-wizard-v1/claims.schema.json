            "maxLength": 500
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "job_id",
          "question",
          "options",
          "why"
        ],
        "properties": {
          "job_id": {
            "type": "string"
          },
          "question": {
            "type": "string",
            "maxLength": 300
          },
          "options": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "value"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "why": {
            "type": "string",
            "maxLength": 300
          }
